{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@site/*": ["./*"],
      "@/*": ["./src/*"]
    },
    "types": ["node", "@docusaurus/module-type-aliases"],
    "jsx": "react-jsx",
    "downlevelIteration": true,
    // The base config sets lib to ES2022 + DOM. Without DOM.Iterable a NodeList
    // has no [Symbol.iterator], so spreading querySelectorAll results fails to
    // type-check -- which the lint-staged tsc-files gate runs on every commit.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "docs", "scripts"]
}
